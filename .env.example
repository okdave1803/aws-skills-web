# AWS Skills - 環境変数設定テンプレート
# このファイルをコピーして .env を作成し、必要に応じて値を変更してください

# ===== 環境設定 =====
DEBUG=false
ENVIRONMENT=development  # development | staging | production

# ===== セキュリティ設定 =====
# 注意: 本番環境では必ず強力なシークレットキーを設定してください
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ===== データベース設定 =====
# SQLite（開発環境推奨）
DATABASE_URL=sqlite:///./aws_skills.db

# PostgreSQL（本番環境推奨）
# DATABASE_URL=postgresql://user:password@localhost:5432/aws_skills
POSTGRES_USER=aws_skills
POSTGRES_PASSWORD=secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aws_skills

# ===== ロギング設定 =====
LOG_LEVEL=INFO
# DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== クッキー設定 =====
# 本番環境では COOKIE_SECURE=true にしてください（HTTPS必須）
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Strict  # Strict | Lax | None

# ===== レート制限 =====
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ===== 機能フラグ =====
FEATURE_AUTHENTICATION=true      # ユーザー認証機能
FEATURE_DATABASE=false           # データベース機能（デフォルトOFF、Phase 3で有効化）
FEATURE_BACKUP=false             # 自動バックアップ機能
